{
  "manifest_version": 3,
  "name": "Adaptive Video Downloader",
  "version": "2.1.0",
  "description": "Download almost any video: HLS, DASH, segment streams and direct files \u2014 with Auto and Manual modes, a live queue and download history.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "unlimitedStorage",
    "tabs",
    "offscreen",
    "downloads",
    "downloads.open",
    "notifications",
    "contextMenus",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Adaptive Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
