{
  "manifest_version": 2,
  "name": "Adaptive Video Downloader",
  "version": "2.1.0",
  "description": "Download almost any video: HLS, DASH, segment streams and direct files \u2014 with Auto and Manual modes, a live queue and download history.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "downloads.open",
    "notifications",
    "contextMenus",
    "scripting",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "background": {
    "scripts": [
      "shared.js",
      "manifest.js",
      "captions.js",
      "engine.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Adaptive Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "adaptive-video-downloader@guythatlivesandcodes",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
